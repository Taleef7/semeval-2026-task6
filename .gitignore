# =======================================================================
# .gitignore — PFW at SemEval-2026 Task 6
# =======================================================================

# --- Python ------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/

# --- Caches ------------------------------------------------------------
.cache/
hf_cache/

# --- Training outputs (large) -----------------------------------------
/runs/
/models/
/checkpoints/
/outputs/
*.pt
*.ckpt
*.safetensors

# --- Artifacts (OOF logits, splits, etc.) -----------------------------
/artifacts/

# --- Logs --------------------------------------------------------------
/logs/
*.log
texput.log

# --- Submissions (task outputs) ---------------------------------------
/submissions/
eval_solution.zip
/task1_eval_solution/
/task2_eval_solution/

# --- Raw data (subject to dataset license) ----------------------------
/data/
clarity_task_evaluation_dataset.csv
*.jsonl
*.parquet
*.npy

# CSVs excluded by default; allow the small paper-figure tables
*.csv
!docs/paper_figures/*.csv

# --- Binary / large files ---------------------------------------------
*.zip
# Ignore top-level PDFs (e.g., external references) but keep the paper
# and the camera-ready figure PDFs.
/*.pdf
!latex/acl_latex.pdf
!docs/paper_figures/*.pdf

# --- Internal / in-progress documentation -----------------------------
# These are working notes that lived in the repo during development;
# the public documentation lives in README.md + docs/methodology_report.md.
docs/advisor_commands.md
docs/advisor_update.md
docs/baseline_registry.md
docs/gold_submissions.json
docs/M7_QUICK_START.md
docs/M7_strategic_plan.md
docs/paper_outline.md

# --- OS / editor -------------------------------------------------------
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*~

# --- Jupyter -----------------------------------------------------------
.ipynb_checkpoints/
*.ipynb

# --- Environment -------------------------------------------------------
.env
.env.local

# --- LaTeX build artifacts --------------------------------------------
latex/*.aux
latex/*.bbl
latex/*.blg
latex/*.fdb_latexmk
latex/*.fls
latex/*.out
latex/*.synctex.gz
latex/*.bak
latex/compile_log.txt
latex/errors-acl.json

# --- Editor / IDE config used during development ----------------------
.github/copilot-instructions.md
